# HMAC Cryptographic Signing Secret
# Used by Vercel serverless APIs (/api/create-order and /api/verify-order)
ORDER_SIGNING_SECRET="your_production_order_signing_secret_key"

# CORS Allowed Origin for Serverless Endpoints
ALLOWED_ORIGIN="https://shop-speedabraker.vercel.app"

# Firebase Admin SDK Credentials for Serverless Functions (Option A: Full JSON string)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Firebase Admin SDK Credentials (Option B: Individual parameters)
# FIREBASE_PROJECT_ID="shop-speedabraker"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@shop-speedabraker.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
