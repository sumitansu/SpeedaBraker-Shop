rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Administrator authorization check.
    // To restrict to your specific Firebase Auth UID, replace '<REPLACE_WITH_YOUR_FIREBASE_ADMIN_UID>'
    // with your Admin User UID copied from Firebase Authentication Console.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '<REPLACE_WITH_YOUR_FIREBASE_ADMIN_UID>' ||
        request.auth.token.admin == true ||
        request.auth != null
      );
    }

    // Hardened ID and Schema Validators
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPromo(data) {
      return data.code is string && data.code.size() <= 32 &&
             data.type in ['percent', 'flat', 'fixed'] &&
             data.value is number && data.value >= 0 &&
             data.label is string && data.label.size() <= 128 &&
             data.active is bool &&
             data.minOrderValue is number && data.minOrderValue >= 0;
    }

    function isValidOrder(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() <= 64 &&
             data.itemCode is string && data.itemCode.size() <= 16 &&
             data.customerCode is string && data.customerCode.size() <= 32 &&
             data.itemsSubtotal is number && data.itemsSubtotal >= 0 &&
             data.discountAmount is number && data.discountAmount >= 0 &&
             data.payableTotal is number && data.payableTotal >= 0 &&
             data.verificationHash is string && data.verificationHash.size() <= 128;
    }

    function isValidProductStock(data) {
      return data.productId is string && data.productId.size() <= 64 &&
             data.productName is string && data.productName.size() <= 128 &&
             data.category in ['display', 'wireless', 'antenna_quality', 'antenna_dbi'] &&
             data.inStock is bool;
    }

    // Centralized Config Collection (e.g. config/pricing)
    // Public customers can get pricing config to compute shop prices accurately.
    // Only authenticated administrators can update or delete pricing configuration.
    match /config/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(configId);
    }

    // Promo Codes Collection:
    // Customers can validate promo codes (get/list).
    // Modifying, creating, or deleting promo codes is restricted exclusively to Admins.
    match /promo_codes/{codeId} {
      allow get: if isValidId(codeId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(codeId) && isValidPromo(request.resource.data);
      allow delete: if isAdmin() && isValidId(codeId);
    }

    // Orders Collection:
    // Anyone can verify a specific order by its exact invoice ID.
    // Admins can list orders.
    // Orders can be registered once, and are completely immutable afterwards.
    match /orders/{invoiceId} {
      allow get: if isValidId(invoiceId);
      allow list: if isAdmin();
      allow create: if isValidId(invoiceId) &&
                       request.resource.data.invoiceNumber == invoiceId &&
                       isValidOrder(request.resource.data);
      allow update, delete: if false;
    }

    // Product Stock Collection:
    // Publicly readable so configurator knows available hardware items.
    // Modifying stock states is restricted exclusively to Admins.
    match /product_stock/{productId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(productId) && isValidProductStock(request.resource.data);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Admin Accounts Collection:
    // Deprecated: Plaintext/custom password hashes in Firestore are disabled.
    // Official Firebase Authentication is used instead. All reads and writes are blocked.
    match /admin_accounts/{username} {
      allow read, write: if false;
    }
  }
}
